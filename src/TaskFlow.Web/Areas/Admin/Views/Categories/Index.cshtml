@model List<Category>
@{
    ViewData["Title"] = "Manage Categories";
}

<div class="page-header">
    <h2>Admin Panel</h2>
    <a asp-action="Create" class="btn btn-primary"><i class="fa-solid fa-plus me-1"></i> New Category</a>
</div>
<partial name="_AdminNav" />

<div class="card">
    <div class="card-body p-0">
        <table class="table align-middle mb-0">
            <thead><tr><th>Color</th><th>Name</th><th>Description</th><th>Status</th><th></th></tr></thead>
            <tbody>
                @foreach (var cat in Model)
                {
                    <tr>
                        <td><span class="badge" style="background-color:@cat.ColorHex;">&nbsp;&nbsp;&nbsp;</span></td>
                        <td>@cat.Name</td>
                        <td class="text-muted small">@cat.Description</td>
                        <td><span class="badge @(cat.IsActive ? "bg-success" : "bg-secondary")">@(cat.IsActive ? "Active" : "Inactive")</span></td>
                        <td class="d-flex gap-1">
                            <a asp-action="Edit" asp-route-id="@cat.Id" class="btn btn-sm btn-outline-secondary"><i class="fa-solid fa-pen"></i></a>
                            <form asp-action="Delete" asp-route-id="@cat.Id" method="post" onsubmit="return confirm('Delete this category?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger"><i class="fa-solid fa-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
