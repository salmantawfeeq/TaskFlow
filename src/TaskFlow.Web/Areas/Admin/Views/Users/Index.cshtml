@model AdminUsersViewModel
@{
    ViewData["Title"] = "Manage Users";
}

<div class="page-header"><h2>Admin Panel</h2></div>
<partial name="_AdminNav" />

<div class="card mb-3">
    <div class="card-body">
        <form method="get" class="row g-2">
            <div class="col-md-4">
                <input type="text" name="SearchTerm" value="@Model.Filter.SearchTerm" class="form-control" placeholder="Search users..." />
            </div>
            <div class="col-md-3">
                <select name="Role" class="form-select">
                    <option value="">All Roles</option>
                    <option value="Admin" selected="@(Model.Filter.Role == "Admin")">Admin</option>
                    <option value="Manager" selected="@(Model.Filter.Role == "Manager")">Manager</option>
                    <option value="Employee" selected="@(Model.Filter.Role == "Employee")">Employee</option>
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-outline-primary w-100">Filter</button>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-body p-0">
        <table class="table align-middle mb-0">
            <thead><tr><th>Name</th><th>Email</th><th>Department</th><th>Roles</th><th>Status</th><th>Actions</th></tr></thead>
            <tbody>
                @foreach (var user in Model.Users.Items)
                {
                    <tr>
                        <td>@user.FullName</td>
                        <td>@user.Email</td>
                        <td>@(user.DepartmentName ?? "-")</td>
                        <td>
                            @foreach (var role in user.Roles)
                            {
                                <span class="badge bg-primary me-1">@role</span>
                            }
                        </td>
                        <td>
                            <span class="badge @(user.IsActive ? "bg-success" : "bg-secondary")">@(user.IsActive ? "Active" : "Inactive")</span>
                        </td>
                        <td class="d-flex gap-1 flex-wrap">
                            <form asp-action="SetActiveStatus" asp-route-userId="@user.Id" asp-route-isActive="@(!user.IsActive)" method="post">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-secondary">@(user.IsActive ? "Deactivate" : "Activate")</button>
                            </form>
                            @if (!user.Roles.Contains("Manager"))
                            {
                                <form asp-action="AssignRole" asp-route-userId="@user.Id" asp-route-role="Manager" method="post">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-primary">+ Manager</button>
                                </form>
                            }
                            else
                            {
                                <form asp-action="RemoveRole" asp-route-userId="@user.Id" asp-route-role="Manager" method="post">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger">- Manager</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (Model.Users.TotalPages > 1)
{
    <nav class="mt-4">
        <ul class="pagination justify-content-center">
            @for (var i = 1; i <= Model.Users.TotalPages; i++)
            {
                <li class="page-item @(i == Model.Users.PageNumber ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-PageNumber="@i">@i</a>
                </li>
            }
        </ul>
    </nav>
}
