@using System.Security.Claims
<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TaskFlow</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/5.3.3/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await Html.PartialAsync("_AntiForgeryTokenMeta")
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <div class="app-shell">
            <nav class="sidebar" id="sidebar">
                <div class="sidebar-brand">
                    <i class="fa-solid fa-diagram-project"></i>
                    <span>TaskFlow</span>
                </div>
                <ul class="sidebar-nav">
                    <li><a asp-controller="Dashboard" asp-action="Index"><i class="fa-solid fa-gauge-high"></i><span>Dashboard</span></a></li>
                    <li><a asp-controller="Projects" asp-action="Index"><i class="fa-solid fa-folder-open"></i><span>Projects</span></a></li>
                    <li><a asp-controller="Tasks" asp-action="MyTasks"><i class="fa-solid fa-list-check"></i><span>My Tasks</span></a></li>
                    <li><a asp-controller="Tasks" asp-action="Calendar"><i class="fa-solid fa-calendar-days"></i><span>Calendar</span></a></li>
                    <li><a asp-controller="Teams" asp-action="Index"><i class="fa-solid fa-people-group"></i><span>Teams</span></a></li>
                    <li><a asp-controller="Reports" asp-action="Index"><i class="fa-solid fa-chart-line"></i><span>Reports</span></a></li>
                    @if (User.IsInRole("Admin"))
                    {
                        <li><a asp-area="Admin" asp-controller="Users" asp-action="Index"><i class="fa-solid fa-user-shield"></i><span>Admin Panel</span></a></li>
                    }
                </ul>
            </nav>

            <div class="main-area">
                <header class="topbar">
                    <button class="btn btn-sm btn-icon d-lg-none" id="sidebarToggle"><i class="fa-solid fa-bars"></i></button>

                    <div class="topbar-search d-none d-md-block">
                        <i class="fa-solid fa-magnifying-glass"></i>
                        <input type="search" class="form-control form-control-sm" placeholder="Quick search..." />
                    </div>

                    <div class="topbar-actions">
                        <button class="btn btn-icon" id="themeToggle" title="Toggle dark mode">
                            <i class="fa-solid fa-moon"></i>
                        </button>

                        <div class="dropdown">
                            <button class="btn btn-icon position-relative" data-bs-toggle="dropdown" id="notificationBell">
                                <i class="fa-solid fa-bell"></i>
                                <span class="badge rounded-pill bg-danger notification-count d-none" id="notificationCount">0</span>
                            </button>
                            <div class="dropdown-menu dropdown-menu-end notification-panel" id="notificationPanel">
                                <div class="notification-header">Notifications</div>
                                <div id="notificationList" class="notification-list">
                                    <div class="text-center text-muted p-3">Loading...</div>
                                </div>
                            </div>
                        </div>

                        <div class="dropdown">
                            <button class="btn btn-icon d-flex align-items-center gap-2" data-bs-toggle="dropdown">
                                <span class="avatar-circle">@(User.Identity?.Name?.Substring(0, 1).ToUpper())</span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" asp-controller="Account" asp-action="Profile"><i class="fa-solid fa-user me-2"></i>Profile</a></li>
                                <li><a class="dropdown-item" asp-controller="Account" asp-action="ChangePassword"><i class="fa-solid fa-key me-2"></i>Change Password</a></li>
                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="dropdown-item text-danger"><i class="fa-solid fa-right-from-bracket me-2"></i>Logout</button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    </div>
                </header>

                <main class="page-content">
                    @if (TempData["StatusMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            @TempData["StatusMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }
                    @RenderBody()
                </main>
            </div>
        </div>
    }
    else
    {
        @RenderBody()
    }

    <script src="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/5.3.3/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
