@model TaskDetailDto
@{
    ViewData["Title"] = Model.Title;
}

<div class="page-header">
    <div>
        <h2>@Model.Title</h2>
        <span class="badge" style="background-color:@Model.ProjectColorHex;">@Model.ProjectName</span>
        <span class="priority-badge priority-@Model.Priority.ToString().ToLower()">@Model.Priority</span>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-secondary"><i class="fa-solid fa-pen"></i> Edit</a>
        <form asp-action="Delete" asp-route-id="@Model.Id" asp-route-projectId="@Model.ProjectId" method="post" onsubmit="return confirm('Delete this task?');">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-outline-danger"><i class="fa-solid fa-trash"></i></button>
        </form>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-8">
        <div class="card mb-3">
            <div class="card-body">
                <h6>Description</h6>
                <p class="text-muted">@(Model.Description ?? "No description.")</p>
                <div class="row small text-muted">
                    <div class="col-6"><strong>Created by:</strong> @Model.CreatedByName</div>
                    <div class="col-6"><strong>Due date:</strong> @(Model.DueDate?.ToString("MMM dd, yyyy") ?? "None")</div>
                </div>
            </div>
        </div>

        <!-- Checklist -->
        <div class="card mb-3">
            <div class="card-body">
                <h6 class="mb-3">Checklist (@Model.ChecklistItems.Count(c => c.IsCompleted)/@Model.ChecklistItems.Count)</h6>
                <div id="checklistContainer" data-task-id="@Model.Id">
                    @foreach (var item in Model.ChecklistItems)
                    {
                        <div class="form-check mb-2 checklist-item" data-item-id="@item.Id">
                            <input class="form-check-input checklist-checkbox" type="checkbox" @(item.IsCompleted ? "checked" : "") />
                            <label class="form-check-label @(item.IsCompleted ? "text-decoration-line-through text-muted" : "")">@item.Text</label>
                            <button class="btn btn-sm btn-link text-danger float-end remove-checklist-item p-0"><i class="fa-solid fa-xmark"></i></button>
                        </div>
                    }
                </div>
                <form id="addChecklistForm" class="d-flex gap-2 mt-2">
                    <input type="text" id="newChecklistText" class="form-control form-control-sm" placeholder="Add a checklist item..." />
                    <button type="submit" class="btn btn-sm btn-outline-primary">Add</button>
                </form>
            </div>
        </div>

        <!-- Comments -->
        <div class="card mb-3">
            <div class="card-body">
                <h6 class="mb-3">Comments (@Model.Comments.Count)</h6>
                <div id="commentsContainer" data-task-id="@Model.Id">
                    @foreach (var comment in Model.Comments.Where(c => c.ParentCommentId == null))
                    {
                        <div class="d-flex gap-2 mb-3">
                            <span class="avatar-circle" style="width:32px;height:32px;font-size:0.8rem;flex-shrink:0;">@comment.UserFullName.Substring(0, 1)</span>
                            <div class="flex-grow-1">
                                <div class="small"><strong>@comment.UserFullName</strong> <span class="text-muted">@comment.CreatedAt.ToString("MMM dd, HH:mm")</span></div>
                                <div>@comment.Content</div>
                            </div>
                        </div>
                    }
                </div>
                <form id="addCommentForm" class="d-flex gap-2 mt-2">
                    <input type="text" id="newCommentText" class="form-control form-control-sm" placeholder="Write a comment..." />
                    <button type="submit" class="btn btn-sm btn-primary">Post</button>
                </form>
            </div>
        </div>

        <!-- Activity History -->
        <div class="card">
            <div class="card-body">
                <h6 class="mb-3">Activity History</h6>
                <ul class="list-unstyled mb-0">
                    @foreach (var activity in Model.Activities)
                    {
                        <li class="d-flex gap-2 mb-2 small">
                            <span class="avatar-circle" style="width:26px;height:26px;font-size:0.65rem;flex-shrink:0;">@activity.UserFullName.Substring(0, 1)</span>
                            <div>
                                <strong>@activity.UserFullName</strong> @activity.Description
                                <div class="text-muted" style="font-size:0.72rem;">@activity.CreatedAt.ToString("MMM dd, HH:mm")</div>
                            </div>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card mb-3">
            <div class="card-body">
                <h6 class="mb-3">Assignees</h6>
                @foreach (var assignee in Model.Assignees)
                {
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <span class="avatar-circle" style="width:28px;height:28px;font-size:0.7rem;">@assignee.FullName.Substring(0, 1)</span>
                        <span class="small">@assignee.FullName</span>
                    </div>
                }
            </div>
        </div>

        <div class="card">
            <div class="card-body">
                <h6 class="mb-3">Attachments (@Model.Attachments.Count)</h6>
                @foreach (var attachment in Model.Attachments)
                {
                    <div class="d-flex align-items-center gap-2 mb-2 small">
                        <i class="fa-solid fa-paperclip text-muted"></i>
                        <a href="~/@attachment.FilePath" target="_blank" class="text-truncate">@attachment.FileName</a>
                    </div>
                }
                <form asp-controller="Attachments" asp-action="UploadForTask" asp-route-taskId="@Model.Id" method="post" enctype="multipart/form-data" class="mt-2">
                    @Html.AntiForgeryToken()
                    <input type="file" name="file" class="form-control form-control-sm mb-2" />
                    <button type="submit" class="btn btn-sm btn-outline-primary w-100">Upload</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/task-details.js" asp-append-version="true"></script>
}
