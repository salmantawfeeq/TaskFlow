@model TeamsIndexViewModel
@{
    ViewData["Title"] = "Teams";
}

<div class="page-header">
    <h2>Teams &amp; Departments</h2>
    @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
    {
        <div class="d-flex gap-2">
            <a asp-action="Invite" class="btn btn-outline-primary"><i class="fa-solid fa-user-plus me-1"></i> Invite User</a>
            <a asp-action="CreateDepartment" class="btn btn-outline-secondary"><i class="fa-solid fa-building me-1"></i> New Department</a>
            <a asp-action="Create" class="btn btn-primary"><i class="fa-solid fa-plus me-1"></i> New Team</a>
        </div>
    }
</div>

<h6 class="mb-3">Departments</h6>
<div class="row g-3 mb-4">
    @foreach (var dept in Model.Departments)
    {
        <div class="col-md-4">
            <div class="card">
                <div class="card-body">
                    <h6>@dept.Name</h6>
                    <p class="text-muted small mb-2">@dept.Description</p>
                    <div class="d-flex gap-3 small text-muted">
                        <span><i class="fa-solid fa-users me-1"></i>@dept.MemberCount members</span>
                        <span><i class="fa-solid fa-people-group me-1"></i>@dept.TeamCount teams</span>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<h6 class="mb-3">Teams</h6>
<div class="row g-3">
    @foreach (var team in Model.Teams)
    {
        <div class="col-md-6 col-xl-4">
            <a asp-action="Details" asp-route-id="@team.Id" class="text-decoration-none text-reset">
                <div class="card h-100">
                    <div class="card-body">
                        <h6>@team.Name</h6>
                        <p class="text-muted small mb-2">@team.DepartmentName</p>
                        <div class="d-flex justify-content-between small text-muted">
                            <span><i class="fa-solid fa-user-tie me-1"></i>@team.TeamLeadName</span>
                            <span><i class="fa-solid fa-users me-1"></i>@team.MemberCount</span>
                        </div>
                    </div>
                </div>
            </a>
        </div>
    }
</div>
