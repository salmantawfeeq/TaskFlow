@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Check Your Email";
}

<div class="text-center">
    <i class="fa-solid fa-envelope-circle-check text-success" style="font-size: 3rem;"></i>
    <h3 class="auth-title mt-3">Check your email</h3>
    <p class="auth-subtitle">If that email exists in our system, a password reset link has been sent.</p>

    @if (ViewBag.ResetLink != null)
    {
        <div class="demo-hint mt-4 text-start">
            <strong>Email simulation</strong> — here is the link that would have been sent:
            <div class="mt-2">
                <a href="@ViewBag.ResetLink" class="text-break">@ViewBag.ResetLink</a>
            </div>
        </div>
    }

    <a asp-controller="Account" asp-action="Login" class="btn btn-primary mt-4">Back to Login</a>
</div>
