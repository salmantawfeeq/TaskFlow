@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Password Reset";
}

<div class="text-center">
    <i class="fa-solid fa-circle-check text-success" style="font-size: 3rem;"></i>
    <h3 class="auth-title mt-3">Password reset!</h3>
    <p class="auth-subtitle">You can now log in with your new password.</p>
    <a asp-controller="Account" asp-action="Login" class="btn btn-primary mt-3">Go to Login</a>
</div>
