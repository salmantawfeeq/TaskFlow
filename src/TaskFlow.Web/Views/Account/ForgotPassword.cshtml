@model ForgotPasswordViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Forgot Password";
}

<h3 class="auth-title">Reset your password</h3>
<p class="auth-subtitle">Enter your email and we'll send you a reset link.</p>

<form asp-controller="Account" asp-action="ForgotPassword" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="mb-3">
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" class="form-control" autofocus />
        <span asp-validation-for="Email" class="text-danger small"></span>
    </div>

    <button type="submit" class="btn btn-primary w-100">Send Reset Link</button>
</form>

<p class="text-center mt-4 mb-0 small">
    <a asp-controller="Account" asp-action="Login">Back to login</a>
</p>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
